{
    "$schema": "https://json.schemastore.org/package",
    "name": "frithward",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "engines": {
        "node": ">=26 <27",
        "pnpm": ">=10"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "postinstall": "node scripts/provision-c2pa.mjs",
        "start": "pnpm --filter @frithward/web run start",
        "start:api": "pnpm --filter @frithward/api run start",
        "start:orchestrator": "pnpm --filter @frithward/orchestrator run start",
        "start:media-worker": "pnpm --filter @frithward/media-worker run start",
        "start:inference-worker": "pnpm --filter @frithward/inference-worker run start",
        "start:community": "pnpm --filter @frithward/community run start",
        "start:incident": "pnpm --filter @frithward/incident run start",
        "start:web": "pnpm --filter @frithward/web run start",
        "start:proof": "pnpm --filter @frithward/public-proof run start",
        "lint": "oxlint .",
        "format": "oxfmt -c oxfmt.json .",
        "format:check": "oxfmt --check -c oxfmt.json .",
        "typecheck": "tsc -b",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "check:boundaries": "node scripts/check-boundaries.mjs",
        "check:boundaries:test": "node scripts/check-boundaries.test.mjs",
        "check": "pnpm run format:check && pnpm run lint && pnpm run check:boundaries && pnpm run check:boundaries:test && pnpm run typecheck && pnpm run test"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.0",
        "@solidjs/testing-library": "^0.8.10",
        "@testing-library/dom": "^10.4.2",
        "@types/node": "^26.6.6",
        "axe-core": "^4.14.0",
        "drizzle-orm": "^0.45.4",
        "jsdom": "^31.0.1",
        "oxfmt": "^0.77.0",
        "oxlint": "^1.92.0",
        "playwright": "^1.65.0",
        "solid-js": "1.9.18",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0",
        "vitest-axe": "^0.1.0"
    }
}
