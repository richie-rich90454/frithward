{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "semi": true,
    "singleQuote": false,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "arrowParens": "always",
    "printWidth": 100,
    "proseWrap": "never",
    "htmlWhitespaceSensitivity": "ignore",
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": false,
    "sortPackageJson": false,
    "ignorePatterns": [
        ".git/**",
        "node_modules/**",
        "dist/**",
        "build/**",
        "coverage/**",
        "target/**",
        "vendor/**",
        "generated/**",
        "**/*.min.*",
        "package-lock.json",
        "pnpm-lock.yaml",
        "yarn.lock",
        "bun.lockb",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/*.log",
        "**/*.tmp",
        "**/*.swp",
        "**/*~"
    ]
}
