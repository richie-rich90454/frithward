# Copy to .env (or export these in your shell) and fill in real values.
# No real secrets are included here. Never commit the filled-in file.

# production makes auth require BETTER_AUTH_SECRET; without production the API
# uses an ephemeral per-process secret (sessions do not survive a restart).
NODE_ENV=production

# Each service binds its own PORT. Defaults: api 3000, orchestrator 3001,
# media-worker 3002, inference-worker 3003, community 3004, incident 3005.
# PORT=3000

# PostgreSQL connection string. Required for auth, migrations, persisted job
# status, and the optional job queue. There is no default.
DATABASE_URL=postgresql://frithward:change-me@127.0.0.1:5432/frithward

# Long random secret, e.g. `openssl rand -hex 32`. Required when NODE_ENV=production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# Comma-separated origins allowed by the API's CORS middleware. Empty means
# same-origin only.
CORS_ORIGIN=http://localhost:4173

# Set to 1 (together with DATABASE_URL) to enable the Graphile job queue.
ENABLE_JOB_QUEUE=0

# S3-compatible Garage settings. Storage stays disabled until all four of
# endpoint, bucket, access key, and secret key are set.
GARAGE_ENDPOINT=http://127.0.0.1:3900
GARAGE_BUCKET=frithward
GARAGE_ACCESS_KEY=replace-with-garage-access-key
GARAGE_SECRET_KEY=replace-with-garage-secret-key
# Must match `region` in infrastructure/storage/garage.toml (the code default
# is us-east-1, which will not match the shipped config).
GARAGE_REGION=frithward

# Orchestrator's upstream for inference. Default: http://localhost:3003.
INFERENCE_WORKER_URL=http://127.0.0.1:3003

# Optional: enable OTLP trace export. Unset disables instrumentation; no
# endpoint is hardcoded.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# Caddy site settings. Defaults: localhost, 127.0.0.1:3000, ./apps/web/dist.
FRITHWARD_DOMAIN=localhost
FRITHWARD_API=127.0.0.1:3000
FW_WEB_ROOT=./apps/web/dist
